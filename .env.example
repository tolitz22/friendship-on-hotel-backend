APP_NAME="Friendship On Hotel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=friendship_on_hotel
DB_USERNAME=postgres
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

FRONTEND_ORIGINS=http://localhost:5173

# Initial bearer-token API authentication; browser SPA cookie auth is a later milestone
SANCTUM_TOKEN_EXPIRATION=480
