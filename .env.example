APP_NAME="Friendship On Hotel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en

# Select mysql or pgsql. See docs/DATABASE_COMPATIBILITY.md\nDB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=friendship_on_hotel
DB_USERNAME=postgres
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Legacy memory-only bearer authentication is preserved by default.
SANCTUM_TOKEN_EXPIRATION=480

# Phase 17: enable this ONLY alongside frontend VITE_AUTH_MODE=cookie,
# after configuring matching trusted same-site frontend/API hosts.
SPA_SESSION_ENABLED=false
# Comma-separated hostnames WITH PORTS for the first-party SPA, no scheme.
SANCTUM_STATEFUL_DOMAINS=localhost:5173
# FRONTEND_ORIGINS above must list the corresponding full scheme + origin.
# Production: HTTPS and a shared registrable domain for SPA + API.
SESSION_COOKIE=friendship_on_hotel_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
# Use database or another shared session store on multi-instance hosting;
# the existing file driver is appropriate for single-instance development.


# Phase 16 password reset emails.
# LOG is for LOCAL DEVELOPMENT ONLY: reset links appear in Laravel logs.
# In production configure an authenticated SMTP/email provider and set a
# trusted HTTPS frontend reset page. Never use example.test in production.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="Friendship On Hotel"
STAFF_PASSWORD_RESET_URL=http://localhost:5173/reset-password
# SMTP delivery example:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=smtp

# Phase 18: trusted frontend acceptance URL (HTTPS in production).
STAFF_INVITE_URL=http://localhost:5173/accept-invitation


# Phase 27 generic development-only signed finance observation inbox.
# OFF BY DEFAULT. NOT a real bank/payment-provider webhook integration.
# Only enable with a random, 32+ byte server-side secret and controlled test sender.
FINANCE_CUSTOM_HMAC_ENABLED=false
FINANCE_CUSTOM_HMAC_SECRET=


# Phase 28 PayMongo TEST-MODE webhook only. Disabled by default.
# Use the test webhook endpoint's signing secret, not the API secret key.
# Must configure one hotel ID mapped to your sandbox merchant endpoint.
# Do not use live credentials or enable real payment collection.
PAYMONGO_SANDBOX_WEBHOOK_ENABLED=false
PAYMONGO_SANDBOX_WEBHOOK_SECRET=
PAYMONGO_SANDBOX_HOTEL_ID=

# PN-3: disabled until pilot worker and VAPID configuration are ready.
PMS_PUSH_ENABLED=false
PMS_PUSH_PUBLIC_KEY=
PMS_PUSH_PRIVATE_KEY=
PMS_PUSH_SUBJECT=
# Use all to cover every property; pilot requires an explicit hotel ID.
PMS_PUSH_SCOPE=pilot
PMS_PUSH_HOTEL_ID=

# Keep false for Client Demo acceptance. Explicit approval required for real properties.
PMS_PUSH_ALLOW_NON_DEMO=false
